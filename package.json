{
  "name": "nitu-clay-workshop",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test",
    "format": "prettier --write src scripts/*.mjs tests README.md docs",
    "format:check": "prettier --check src scripts/*.mjs tests README.md docs"
  },
  "devDependencies": { "prettier": "3.6.2" }
}
